# Copy to .env and adjust. All variables are optional; defaults target local SQLite dev.

# --- Runtime ---
ARCHON_ENVIRONMENT=local
ARCHON_LOG_LEVEL=INFO
ARCHON_LOG_JSON=false

# --- Database (SQLite for dev; PostgreSQL for prod) ---
ARCHON_DATABASE_URL=sqlite:///./archon.db
# ARCHON_DATABASE_URL=postgresql+psycopg://archon:archon@localhost:5432/archon

# --- Filesystem / artifacts ---
ARCHON_DATA_ROOT=./_archon_data
ARCHON_WORKSPACE_QUOTA_BYTES=5368709120

# --- GitHub (read from env only; never logged, never passed to the sandbox) ---
# ARCHON_GITHUB_TOKEN=ghp_xxx

# --- Jobs / concurrency ---
ARCHON_MAX_CONCURRENT_RUNS=4
ARCHON_WORKER_POLL_INTERVAL_SECONDS=1.0

# --- Repository limits (spec section 16) ---
ARCHON_LIMIT_MAX_REPO_SIZE_BYTES=524288000
ARCHON_LIMIT_MAX_FILE_COUNT=20000
ARCHON_LIMIT_MAX_GIT_HISTORY_COMMITS=5000

# --- AI (unused until the Claude driver lands in a later phase) ---
# ANTHROPIC_API_KEY=sk-ant-xxx
