# Copy to .env and adjust. All variables are optional; defaults target local SQLite dev.

# --- Runtime ---
ARCHON_ENVIRONMENT=local
ARCHON_LOG_LEVEL=INFO
ARCHON_LOG_JSON=false

# --- Database (SQLite for dev; PostgreSQL for prod) ---
ARCHON_DATABASE_URL=sqlite:///./archon.db
# ARCHON_DATABASE_URL=postgresql+psycopg://archon:archon@localhost:5432/archon

# --- Filesystem / artifacts ---
ARCHON_DATA_ROOT=./_archon_data
ARCHON_WORKSPACE_QUOTA_BYTES=5368709120

# --- GitHub (read from env only; never logged, never passed to the sandbox) ---
# ARCHON_GITHUB_TOKEN=ghp_xxx
# HMAC-SHA256 key for the POST /webhooks/github X-Hub-Signature-256 header (spec section 51)
# ARCHON_GITHUB_WEBHOOK_SECRET=whsec_xxx

# --- Jobs / concurrency ---
ARCHON_MAX_CONCURRENT_RUNS=4
ARCHON_WORKER_POLL_INTERVAL_SECONDS=1.0
ARCHON_JOB_HEARTBEAT_TIMEOUT_SECONDS=120

# --- Repository limits (spec section 16) ---
ARCHON_LIMIT_MAX_REPO_SIZE_BYTES=524288000
ARCHON_LIMIT_MAX_FILE_COUNT=20000
ARCHON_LIMIT_MAX_GIT_HISTORY_COMMITS=5000
ARCHON_LIMIT_MAX_ANALYSIS_DURATION_SECONDS=1800

# --- Operability / abuse controls (spec sections 16, 18, 55) ---
ARCHON_METRICS_ENABLED=true
ARCHON_RATE_LIMIT_ENABLED=true
ARCHON_RATE_LIMIT_RUNS_PER_MINUTE=30
ARCHON_RATE_LIMIT_WEBHOOK_PER_MINUTE=120
ARCHON_MAX_REQUEST_BYTES=2097152
# non-sqlite connection pool
ARCHON_DB_POOL_SIZE=5
ARCHON_DB_MAX_OVERFLOW=10
ARCHON_DB_POOL_PRE_PING=true

# --- AI (spec sections 13-14, 18) ---
# The mock provider is the default and needs nothing. For the real Claude driver:
#   pip install -e "backend[claude]"
ARCHON_AI_PROVIDER=mock
# ARCHON_AI_MODEL=claude-sonnet-5
# ARCHON_AI_TIMEOUT_SECONDS=60
# ARCHON_AI_MAX_RETRIES=2
# ANTHROPIC_API_KEY=sk-ant-xxx
