# Copy to .env.prod (repo root) for docker/docker-compose.prod.yml.
# Nothing here is baked into an image - compose reads this file at `up` time.

# --- Postgres (required) ---
POSTGRES_USER=archon
POSTGRES_PASSWORD=change-me-in-real-life
POSTGRES_DB=archon

# --- API / worker ---
ARCHON_API_PORT=8000
ARCHON_WORKER_REPLICAS=1
ARCHON_LOG_LEVEL=INFO
ARCHON_DATA_ROOT=/data

# --- Secrets (env only; never logged) ---
# ARCHON_GITHUB_TOKEN=ghp_xxx
# ARCHON_GITHUB_WEBHOOK_SECRET=whsec_xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# ARCHON_AI_PROVIDER=mock   # set to "claude" only if the images are built with [claude]

# --- Operability tuning (optional; defaults are sane) ---
# ARCHON_MAX_CONCURRENT_RUNS=4
# ARCHON_RATE_LIMIT_RUNS_PER_MINUTE=30
# ARCHON_DB_POOL_SIZE=5
