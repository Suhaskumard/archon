# ARCHON analysis worker image.
# Phase 7: the worker shells out to the `docker` CLI (DockerSandbox) to launch
# locked-down sandbox containers, so it needs the CLI installed here AND the host's
# Docker socket mounted in at runtime (see docker-compose.yml's worker service) -
# sibling-container access, not Docker-in-Docker.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/ /app/backend/
RUN pip install --no-cache-dir -e "/app/backend[postgres]"

# The worker shells out to `docker` against the mounted host socket; add it to the
# docker group so it can, but otherwise run unprivileged.
RUN useradd --create-home --uid 10001 archon \
    && groupadd -f docker && usermod -aG docker archon

ENV ARCHON_DATA_ROOT=/data
RUN mkdir -p /data && chown -R archon:archon /data /app
USER archon
VOLUME ["/data"]

# Liveness: the process can import its stack and reach the database.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "from archon.db.migrate import is_up_to_date; import sys; sys.exit(0 if is_up_to_date() else 1)" || exit 1

CMD ["python", "-m", "archon.cli.main", "worker"]
